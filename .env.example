# Ключи живут только на сервере. Фронтенд их не видит.
COARENA_API_KEYS=key1,key2,key3
COARENA_BASE_URL=https://coarena.ai/api/v1
# openai | anthropic
COARENA_PROTOCOL=openai
# bearer | x-api-key
COARENA_AUTH_MODE=bearer
# round-robin | first-available
KEY_STRATEGY=round-robin
ADMIN_TOKEN=change-me-long-random-string
ALLOWED_ORIGIN=https://your-domain.example
MAX_UPLOAD_MB=10
RATE_LIMIT_PER_MIN=30
